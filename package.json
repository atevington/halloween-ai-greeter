{
  "name": "halloween-ai-greeter",
  "version": "1.0.0",
  "description": "A spooky face detection and greeting system that generates Halloween-themed greetings using OpenAI's vision capabilities",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "halloween",
    "face-detection",
    "opencv",
    "computer-vision",
    "greeter",
    "ai",
    "openai",
    "text-to-speech",
    "tts",
    "vision"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@techstark/opencv-js": "4.11.0-release.1",
    "jimp": "^1.6.1",
    "openai": "^7.39.0",
    "screenshot-desktop": "^1.15.7",
    "sound-play": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/sound-play": "^1.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
